   "text": "On the machine this was written on, sysctl hw.cachelinesize reports 128.",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "On the machine this was written on, sysctl hw.cachelinesize reports 128.",
   "lineHeight": 1.25
  },
  {
   "id": "e1042",
