: 13, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C is 300 x 300", "lineHeight": 1.25}, {"id": "e1014", "type": "text", "x": 382.0, "y": 118.0, "width": 171.12, "height": 15.0, "angle": 0, "strokeColor": "#141414", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1014, "version": 1, "versionNonce": 1014, "isDeleted": false, "boundElements": null, "updated": 1785600000000, "link": null, "locked": false, "text": "the tiles are 128 x 128", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "the tiles are 128 x 128", "lineHeight": 1.25}, {"id": "e1015", "type": "text", "x": 382.0, "y": 142.0, "width": 215.76, "height": 15.0, "angle": 0, "strokeColor": "#141414", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1015, "version": 1, "versionNonce": 1015, "isDeleted": false, "boundElements": null, "updated": 1785600000000, "link": null, "locked": false, "text": "300 / 128 = 2.34, so 3 a side", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "300 / 128 = 2.34, so 3 a side", "lineHeight": 1.25}, {"id": "e1016", "type": "text", "x": 382.0, "y": 166.0, "width": 238.08, "height": 15.0, "angle": 0, "strokeColor": "#141414", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1016, "version": 1, "versionNonce": 1016, "isDeleted": false, "boundElements": null, "updated": 1785600000000, "link": null, "locked": false, "text": "9 tiles launched, 4 of them full", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "9 tiles launched, 4 of them full", "lineHeight": 1.25}, {"id": "e1017", "type": "text", "x": 382.0, "y": 190.0, "width": 186.0, "height": 15.0, "angle": 0, "strokeColor": "#141414", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1017, "version": 1, "versionNonce": 1017, "isDeleted": false, "boundElements": null, "updated": 1785600000000, "link": null, "locked": false, "text": "the grid covers 384 x 384", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "the grid covers 384 x 384", "lineHeight": 1.25}, {"id": "e1018", "type": "text", "x": 382.0, "y": 214.0, "width": 230.64, "height": 15.0, "angle": 0, "strokeColor": "#141414", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1018, "version": 1, "versionNonce": 1018, "isDeleted": false, "boundElements": null, "updated": 1785600000000, "link": null, "locked": false, "text": "61% of what it computes is real", "fontSize": 12, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "61% of what it computes is real", "lineHeight": 1.25}, {"id": "e1019", "type": "rectangle", "x": 60.0, "y": 372.0, "width": 14.0, "height": 14.0, "angle": 0, "strokeColor": "#141414", "backgroundColor": "#b8ff9f", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 35, "groupIds": [], "frameId": null, "roundness": null, "seed": 1019, "version": 1, "versionNonce": 1019, "isDeleted": false, "boundElements": null, "updated": 1785600000000, "link": null, "locked": false}, {"id": "e1020", "type": "text", "x": 82.0, "y": 373.0, "width": 7