---
/**
 * NullSpaceExplorer: two sliders set the free variables of the doubled-columns
 * matrix [[1,2,2,4],[3,8,6,16]]. The solution vector wanders over the flat
 * two-dimensional sheet spanned by the special solutions s1 and s2, and the
 * readout of A times that vector stays pinned at zero the whole time.
 * Zero dependencies, ~2KB of JS on the page.
 */

// The sheet is drawn in oblique projection: s1 goes to (46, 13) pixels and
// s2 goes to (-21, 35) pixels, measured from the origin at (170, 150).
const OX = 170;
const OY = 150;
const S1 = [46, 13];
const S2 = [-21, 35];
const LIM = 2.3;
const pt = (a: number, c: number) => [OX + a * S1[0] + c * S2[0], OY + a * S1[1] + c * S2[1]];
const ticks = [-2, -1, 0, 1, 2];
const corners = [
  pt(LIM, LIM),
  pt(LIM, -LIM),
  pt(-LIM, -LIM),
  pt(-LIM, LIM),
]
  .map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`)
  .join(' ');
---

<div class="nullspace-explorer card-brutal my-8 overflow-hidden">
  <div class="border-b-2 border-rule bg-wash px-4 py-2">
    <span class="label !text-ink">Try it. Turn the two free variables</span>
  </div>

  <div class="grid gap-4 p-4 sm:grid-cols-[1fr_15rem]">
    <svg
      viewBox="0 0 340 300"
      class="mx-auto w-full max-w-[24rem]"
      aria-label="Interactive picture: a flat sheet spanned by the two special solutions, with a point that moves as the free variables change"
    >
      <polygon points={corners} fill="var(--color-part2)" fill-opacity="0.35" stroke="none" />
      <g stroke="var(--color-ink-faint)" stroke-width="0.9" opacity="0.55">
        {
          ticks.map((k) => {
            const [x1, y1] = pt(k, -LIM);
            const [x2, y2] = pt(k, LIM);
            return <line x1={x1.toFixed(1)} y1={y1.toFixed(1)} x2={x2.toFixed(1)} y2={y2.toFixed(1)} />;
          })
        }
        {
          ticks.map((k) => {
            const [x1, y1] = pt(-LIM, k);
            const [x2, y2] = pt(LIM, k);
            return <line x1={x1.toFixed(1)} y1={y1.toFixed(1)} x2={x2.toFixed(1)} y2={y2.toFixed(1)} />;
          })
        }
      </g>
      <polygon points={corners} fill="none" stroke="var(--color-ink)" stroke-width="1.6" opacity="0.7" />
      <line
        x1={OX}
        y1={OY}
        x2={(OX + S1[0]).toFixed(1)}
        y2={(OY + S1[1]).toFixed(1)}
        stroke="var(--color-stroke-warm)"
        stroke-width="3"
        stroke-linecap="round"
      />
      <line
        x1={OX}
        y1={OY}
        x2={(OX + S2[0]).toFixed(1)}
        y2={(OY + S2[1]).toFixed(1)}
        stroke="var(--color-stroke-green)"
        stroke-width="3"
        stroke-linecap="round"
      />
      <line class="x-arrow" x1={OX} y1={OY} x2={OX} y2={OY} stroke="var(--color-accent)" stroke-width="3.5" stroke-linecap="round" />
      <circle class="x-dot" cx={OX} cy={OY} r="5.5" fill="var(--color-accent)" />
      <circle cx={OX} cy={OY} r="3" fill="var(--color-ink-faint)" />
      <text x="222" y="168" fill="var(--color-ink)" font-size="14" font-style="italic" font-family="var(--font-serif)">s₁</text>
      <text x="132" y="194" fill="var(--color-ink)" font-size="14" font-style="italic" font-family="var(--font-serif)">s₂</text>
      <text x="182" y="146" fill="var(--color-ink-faint)" font-size="12" font-family="var(--font-serif)">0</text>
      <text x="20" y="26" fill="var(--color-ink-muted)" font-size="12" font-family="var(--font-serif)">N(A), a flat sheet in R⁴</text>
    </svg>

    <div class="flex flex-col justify-center gap-3">
      <div class="flex flex-wrap gap-1.5" role="group" aria-label="Preset free variables">
        <button class="preset chip chip-ghost !px-3 !py-2 !text-[0.72rem] min-w-[2.5rem] text-center" data-v="1,0">s₁</button>
        <button class="preset chip chip-ghost !px-3 !py-2 !text-[0.72rem] min-w-[2.5rem] text-center" data-v="0,1">s₂</button>
        <button class="preset chip chip-ghost !px-3 !py-2 !text-[0.72rem] min-w-[2.5rem] text-center" data-v="1,1">s₁ + s₂</button>
        <button class="preset chip chip-ghost !px-3 !py-2 !text-[0.72rem] min-w-[2.5rem] text-center" data-v="0,0">origin</button>
      </div>
      <label class="block">
        <span class="label" style="text-transform:none">x₃ = <output class="a-out !text-ink">1.2</output></span>
        <input class="a-in mt-1 w-full accent-[var(--color-stroke-warm)]" type="range" min="-2" max="2" step="0.1" value="1.2" />
      </label>
      <label class="block">
        <span class="label" style="text-transform:none">x₄ = <output class="c-out !text-ink">0.7</output></span>
        <input class="c-in mt-1 w-full accent-[var(--color-stroke-green)]" type="range" min="-2" max="2" step="0.1" value="0.7" />
      </label>
      <p class="font-mono text-[0.82rem] text-ink-soft">
        x = (<span class="x-out">-2.4, -1.4, 1.2, 0.7</span>)
      </p>
      <p class="font-mono text-[0.82rem] text-ink-soft">
        Ax = (<span class="ax-out">0.00, 0.00</span>)
      </p>
      <p class="text-[0.82rem] text-ink-muted">
        The two pivot entries follow the two knobs, and the readout never leaves zero. Every point
        of the shaded sheet is a solution of Ax = 0.
      </p>
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.nullspace-explorer')) {
    const OX = 170;
    const OY = 150;
    const S1 = [46, 13];
    const S2 = [-21, 35];
    const A = [
      [1, 2, 2, 4],
      [3, 8, 6, 16],
    ];
    const aIn = root.querySelector<HTMLInputElement>('.a-in')!;
    const cIn = root.querySelector<HTMLInputElement>('.c-in')!;
    const arrow = root.querySelector<SVGLineElement>('.x-arrow')!;
    const dot = root.querySelector<SVGCircleElement>('.x-dot')!;
    const show = (v: number) => (Object.is(v, -0) ? 0 : v).toFixed(1);

    function update() {
      const a = Number(aIn.value);
      const c = Number(cIn.value);
      // x = a * s1 + c * s2 with s1 = (-2, 0, 1, 0) and s2 = (0, -2, 0, 1)
      const x = [-2 * a, -2 * c, a, c];
      const ax = A.map((row) => row.reduce((sum, v, i) => sum + v * x[i], 0));
      const px = OX + a * S1[0] + c * S2[0];
      const py = OY + a * S1[1] + c * S2[1];
      arrow.setAttribute('x2', px.toFixed(1));
      arrow.setAttribute('y2', py.toFixed(1));
      dot.setAttribute('cx', px.toFixed(1));
      dot.setAttribute('cy', py.toFixed(1));
      root.querySelector('.a-out')!.textContent = show(a);
      root.querySelector('.c-out')!.textContent = show(c);
      root.querySelector('.x-out')!.textContent = x.map(show).join(', ');
      root.querySelector('.ax-out')!.textContent = ax
        .map((v) => (Object.is(v, -0) ? 0 : v).toFixed(2))
        .join(', ');
    }

    aIn.addEventListener('input', update);
    cIn.addEventListener('input', update);
    for (const btn of root.querySelectorAll<HTMLButtonElement>('.preset')) {
      btn.addEventListener('click', () => {
        const [a, c] = btn.dataset.v!.split(',');
        aIn.value = a;
        cIn.value = c;
        update();
      });
    }
    update();
  }
</script>
