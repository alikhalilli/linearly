---
/**
 * Figure — a numbered diagram with caption. Drawings are committed as SVG
 * (sources in drawings/), exported 1:1 from their Excalidraw sources, and
 * inherit the page's ink color via currentColor so they render correctly in
 * both themes.
 *
 * Every exported drawing carries per-element sequence annotations (data-s,
 * stamped by scripts/export-figures.mjs in authoring order), so each figure
 * can replay itself like a teacher drawing it: the play chip beside the
 * figure label animates strokes on and fades parts in, in that order.
 */
interface Props {
  src?: string;
  alt?: string;
  n?: string | number;
}
const { src, alt, n } = Astro.props;
---

<figure class="my-12">
  {
    src ? (
      <img src={src} alt={alt ?? ''} class="mx-auto" loading="lazy" decoding="async" />
    ) : (
      <div class="figure-inline mx-auto flex overflow-x-auto text-ink [&>svg]:mx-auto">
        <slot name="drawing" />
      </div>
    )
  }
  <figcaption class="mt-3 text-center text-[0.9375rem] text-ink-muted">
    {
      !src && (
        <button class="fig-anim-btn" aria-label="Animate this figure" title="Animate">
          <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M2 1.2 8.6 5 2 8.8Z" fill="currentColor" />
          </svg>
        </button>
      )
    }
    {n !== undefined && <span class="label !tracking-[0.1em]">Fig. {n}&ensp;</span>}
    <slot />
  </figcaption>
</figure>

<script>
  // One listener for every figure on the page: replay the drawing in its
  // authored order. Groups sharing a data-s value appear together; delays
  // come from the rank of each sequence value, so curated sources can stage
  // several elements on one beat.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.fig-anim-btn');
    if (!btn) return;
    const svg = btn.closest('figure')?.querySelector('.figure-inline > svg');
    if (!svg) return;
    const groups = [...svg.querySelectorAll(':scope > g[data-s]')] as SVGGElement[];
    if (!groups.length) return;
    const seqs = [...new Set(groups.map((g) => Number(g.dataset.s)))].sort((a, b) => a - b);
    const rank = new Map(seqs.map((v, i) => [v, i]));
    const step = Math.max(80, Math.min(240, 2400 / seqs.length));
    for (const g of groups) {
      g.style.setProperty('--fad', `${(rank.get(Number(g.dataset.s)) ?? 0) * step}ms`);
    }
    svg.classList.remove('fig-anim');
    void (svg as unknown as SVGGraphicsElement).getBoundingClientRect();
    svg.classList.add('fig-anim');
  });
</script>
