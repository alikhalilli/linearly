---
/**
 * The current lecture's contents, styled after Notion: a quiet header naming
 * the lecture, its sections beneath in small gray type, the active one
 * darkening as the reader scrolls, and one faint escape to the lectures
 * index. Used twice per lecture page: in the rail's hover panel and in the
 * mobile drawer. The .toc-link scrollspy classes are driven by the script in
 * pages/lectures/[...slug].astro.
 */
interface Props {
  numberLabel: string;
  title: string;
  headings: { slug: string; text: string }[];
}
const { numberLabel, title, headings } = Astro.props;
---

<nav aria-label="Contents">
  <p class="toc-head">
    <span class="toc-num">{numberLabel}</span>
    <span>{title}</span>
  </p>
  <ul class="m-0 mt-1.5 list-none space-y-px p-0">
    {
      headings.map((h) => (
        <li>
          <a href={`#${h.slug}`} data-target={h.slug} class="toc-link" title={h.text}>
            {h.text}
          </a>
        </li>
      ))
    }
  </ul>
  <div class="toc-sep" aria-hidden="true"></div>
  <a href="/lectures" class="toc-all">All lectures</a>
</nav>

<style>
  /* All type and color lives here, unlayered, so it wins over the global
     link styles and Tailwind's layered utilities without any !important. */
  .toc-head {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin: 0;
    padding: 0.28rem 0.55rem;
    overflow: hidden;
    white-space: nowrap;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .toc-num {
    flex: none;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    font-weight: 500;
    opacity: 0.55;
  }
  .toc-link {
    display: block;
    padding: 0.24rem 0.55rem 0.24rem 1.7rem;
    border-radius: 6px;
    font-size: 0.85rem;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition:
      background-color 0.1s ease,
      color 0.1s ease;
  }
  .toc-link:hover {
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
    color: var(--color-ink);
  }
  .toc-link.active {
    color: var(--color-ink);
    font-weight: 550;
  }
  .toc-sep {
    margin: 0.6rem 0.5rem 0.3rem;
    border-top: 1px solid color-mix(in oklab, var(--color-rule) 18%, transparent);
  }
  .toc-all {
    display: block;
    padding: 0.22rem 0.55rem;
    border-radius: 6px;
    font-size: 0.78rem;
    color: var(--color-ink-faint);
    text-decoration: none;
    transition:
      background-color 0.1s ease,
      color 0.1s ease;
  }
  .toc-all:hover {
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
    color: var(--color-ink);
  }
</style>
