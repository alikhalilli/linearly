---
/**
 * The course contents, styled after Notion's sidebar: quiet small type, no
 * borders, soft rounded hover pills, the current lecture a slightly darker
 * pill, its sections indented beneath it with the active one darkening as
 * the reader scrolls. Used twice per lecture page: desktop sidebar and
 * mobile drawer. The .toc-link scrollspy classes are driven by the script
 * in pages/lectures/[...slug].astro.
 */
import { numberLabel } from '../lib/course';

interface Item {
  id: string;
  number: number;
  title: string;
  planned: boolean;
}
interface Group {
  part: string;
  roman: string;
  swatch: string;
  items: Item[];
}
interface Props {
  groups: Group[];
  currentId: string;
  headings: { slug: string; text: string }[];
}
const { groups, currentId, headings } = Astro.props;
---

<nav aria-label="Course contents">
  {
    groups.map((g) => (
      <div class="mt-6 first:mt-0">
        <p class="flex items-center gap-1.5 px-2 pb-1">
          <span
            class:list={['h-1.5 w-1.5 shrink-0 rounded-full opacity-80', g.swatch]}
            aria-hidden="true"
          />
          <span class="toc-part">
            {g.roman} · {g.part}
          </span>
        </p>
        <ul class="m-0 list-none space-y-px p-0">
          {g.items.map((it) =>
            it.planned ? (
              <li class="toc-row planned">
                <span class="toc-num">{numberLabel(it.number)}</span>
                <span class="toc-title">{it.title}</span>
              </li>
            ) : it.id === currentId ? (
              <li>
                <span aria-current="page" class="toc-row current">
                  <span class="toc-num">{numberLabel(it.number)}</span>
                  <span class="toc-title">{it.title}</span>
                </span>
                {headings.length > 0 && (
                  <ul class="m-0 mt-0.5 list-none space-y-px p-0 pl-[1.7rem]">
                    {headings.map((h) => (
                      <li>
                        <a href={`#${h.slug}`} data-target={h.slug} class="toc-link">
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ) : (
              <li>
                <a href={`/lectures/${it.id}`} class="toc-row">
                  <span class="toc-num">{numberLabel(it.number)}</span>
                  <span class="toc-title">{it.title}</span>
                </a>
              </li>
            ),
          )}
        </ul>
      </div>
    ))
  }
</nav>

<style>
  /* All type and color lives here, unlayered, so it wins over the global
     link styles and Tailwind's layered utilities without any !important. */
  .toc-part {
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .toc-row {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    padding: 0.22rem 0.5rem;
    border-radius: 6px;
    font-size: 0.83rem;
    line-height: 1.35;
    color: var(--color-ink-muted);
    text-decoration: none;
    transition: background-color 0.1s ease, color 0.1s ease;
  }
  a.toc-row:hover {
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
    color: var(--color-ink);
  }
  .toc-row.current {
    background: color-mix(in oklab, var(--color-ink) 7%, transparent);
    color: var(--color-ink);
    font-weight: 550;
  }
  .toc-row.planned {
    opacity: 0.4;
  }
  .toc-num {
    flex: none;
    width: 2ch;
    text-align: right;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    opacity: 0.65;
  }
  .toc-title {
    min-width: 0;
  }
  .toc-link {
    display: block;
    padding: 0.16rem 0.5rem;
    border-radius: 6px;
    font-size: 0.78rem;
    line-height: 1.35;
    color: var(--color-ink-faint);
    text-decoration: none;
    transition: background-color 0.1s ease, color 0.1s ease;
  }
  .toc-link:hover {
    background: color-mix(in oklab, var(--color-ink) 6%, transparent);
    color: var(--color-ink);
  }
  .toc-link.active {
    color: var(--color-ink);
    font-weight: 550;
  }
</style>
