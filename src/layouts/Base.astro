---
import '@fontsource-variable/stix-two-text';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path to a social-card image, absolute from site root. */
  image?: string;
}

const { title, description, image } = Astro.props;
// build.format 'file' puts ".html" in build-time pathnames; canonical URLs
// use the clean paths Netlify actually serves.
const cleanPath = Astro.url.pathname.replace(/\/index\.html$/, '/').replace(/\.html$/, '');
const canonical = new URL(cleanPath, Astro.site);
const socialImage = new URL(image ?? '/og-default.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="linearly" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="linearly" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script is:inline>
      // Theme, before first paint. Light is the default; dark is a choice.
      if (localStorage.getItem('theme') === 'dark') {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Selecting and copying rendered math yields its LaTeX source.
      import 'katex/contrib/copy-tex';
    </script>
  </body>
</html>
